# ─────────────────────────────────────────────────────────────────────
# Sahāy Mobile — Environment Template
# ─────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and set EXPO_PUBLIC_API_URL to your dev
# machine's LAN IP so the mobile app can reach the FastAPI backend.
#
# ⚠  On a physical Android device, `localhost` resolves to the DEVICE
#    itself, NOT your dev machine. You MUST use your LAN IP.
#
# Quick setup:
#   1. Start the FastAPI backend:  uvicorn app.main:app --reload --port 8000
#   2. Find your dev machine's LAN IP:
#        Windows:  ipconfig       (look for IPv4 Address on Wi-Fi/Ethernet)
#        macOS:    ifconfig | grep inet
#        Linux:    hostname -I
#   3. Set EXPO_PUBLIC_API_URL below to http://<your-LAN-IP>:8000
#   4. Run:  npm run mobile   (expo start)
#
# The backend must be reachable at <your-LAN-IP>:8000 from the device.
# Ensure your firewall allows inbound connections on port 8000.
# ─────────────────────────────────────────────────────────────────────

EXPO_PUBLIC_API_URL=http://192.168.1.100:8000
