{
  "expo": {
    "name": "Sahāy",
    "slug": "sahay-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "sahay",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#F8F6F0"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sahay.mobile",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "location"
        ],
        "NSLocationWhenInUseUsageDescription": "Sahāy uses your location to monitor safe-zone boundaries and alert your family if you wander.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Sahāy needs background location to monitor safe-zone boundaries even when the app is closed, so it can alert your family if you wander.",
        "NSLocationAlwaysUsageDescription": "Sahāy needs background location to monitor safe-zone boundaries even when the app is closed, so it can alert your family if you wander."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F8F6F0"
      },
      "package": "com.sahay.mobile",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-av",
      [
        "expo-sqlite",
        {
          "enableFTS": false,
          "useSQLCipher": true
        }
      ],
      [
        "react-native-background-geolocation",
        {
          "locationForegroundService": {
            "notificationTitle": "Sahāy Safe-Zone Monitoring",
            "notificationBody": "Tap to open the app."
          },
          "backgroundPermissionRationale": {
            "title": "Allow {applicationName} to access your location in the background",
            "message": "SaHay uses your location only to keep you inside your safe zone and alert your family if you wander.",
            "positiveButton": "Allow",
            "negativeButton": "Not now"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "environment": "development",
      "productionApiUrl": "https://api.sahay.platform",
      "eas": {
        "projectId": "9e1e557c-d4dd-43de-90ff-1210ed02ea7c"
      }
    }
  }
}
