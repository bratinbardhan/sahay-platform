{
  "name": "sahay-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Sahāy — AI Dementia Therapeutic Platform monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace=@sahay/mobile",
    "web": "npm run dev --workspace=@sahay/web",
    "types:build": "npm run build --workspace=@sahay/types",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@expo/config-plugins": "~54.0.5",
    "expo-updates": "~29.0.20"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10"
  }
}
