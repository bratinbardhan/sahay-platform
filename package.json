{
  "name": "sahay-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Sahāy — AI Dementia Therapeutic Platform monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace=@sahay/mobile",
    "web": "npm run dev --workspace=@sahay/web",
    "types:build": "npm run build --workspace=@sahay/types",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@expo/config-plugins": "^57.0.9"
  }
}
