# Sahāy API — environment template. Copy to `.env` and edit.

# Application
APP_NAME=Sahāy API
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON_ENABLED=true

# Server
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Database (PostgreSQL via asyncpg; swap scheme for sqlite fallback)
DATABASE_URL=postgresql+asyncpg://sahay:sahay@localhost:5432/sahay
DATABASE_URL_SYNC=postgresql+psycopg2://sahay:sahay@localhost:5432/sahay
# Local dev without Postgres:
# DATABASE_URL=sqlite+aiosqlite:///./sahay.db
# DATABASE_URL_SYNC=sqlite:///./sahay.db

# Reminiscence media storage (S3)
USE_LOCAL_STORAGE=true
LOCAL_UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=26214400
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_BUCKET=

# Twilio anti-wandering SMS
TWILIO_ACCOUNT_ID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_ENABLED=false
TWILIO_MAX_RETRIES=3